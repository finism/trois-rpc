# Client ID de ton application Discord (portal.discord.com/developers)
DISCORD_CLIENT_ID=TON_APPLICATION_ID

# Port local sur lequel le userscript envoie les mises à jour
PORT=9877

# Nom de l'asset (image) uploadé dans le portail développeur Discord
# à utiliser comme grande image par défaut (ex: logo SPK)
# Peut aussi être une URL externe directe, ex: https://trois.id/img/spk.png
LARGE_IMAGE_KEY=spk_logo

# Texte affiché au survol de la grande image
LARGE_IMAGE_TEXT=TROIS.ID / Archives SPK

# Délai (ms) sans nouvelle mise à jour avant de considérer que
# l'écoute s'est arrêtée et d'effacer la Rich Presence
IDLE_TIMEOUT_MS=20000
